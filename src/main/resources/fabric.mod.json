{
  "schemaVersion": 1,
  "id": "tidin_autofish",
  "version": "${version}",
  "name": "Ctrl 自动钓鱼",
  "description": "服务器自定义钓鱼条的自动收线：识别屏幕上的鱼条与指针，指针压到绿色段就按右键收线；溅水花字幕出现时自动咬钩，收线后按设定节奏自动重抛。指针速度随机，用横向速度外推补偿延迟。设置页需要 Cloth Config API。",
  "authors": [
    "BlockForge"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cn.blockforge.autofish.AutoFishMod"
    ],
    "modmenu": [
      "cn.blockforge.autofish.ModMenuIntegration"
    ]
  },
  "mixins": [
    "tidin_autofish.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "${minecraft_dep}",
    "java": ">=17",
    "fabric-api": "*"
  },
  "recommends": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
